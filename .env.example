NODE_ENV=development
PORT=3001
DATABASE_PATH=./data/app.db

# Comma-separated allowlist. Empty = allow all origins.
CORS_ORIGINS=

SESSION_SECRET=change-me-to-a-long-random-string
# Public URL the browser uses (the Vite dev server in development).
BASE_URL=http://localhost:5173

# Required unless DEV_LOGIN=true.
COMMISSIONER_DISCORD_USERNAME=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Log in as seeded users (npm run seed:dev). Refused in production.
DEV_LOGIN=true

# Scrapes VLR match stats once a minute; "off" disables it.
SCHEDULER=on
